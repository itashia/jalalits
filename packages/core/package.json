{
  "name": "jalalits",
  "version": "0.1.0",
  "description": "A modern, powerful, zero-dependency Persian (Jalali) date and time library built with TypeScript.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "tsdown": "^0.23.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itashia/jalalits.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/itashia/jalalits#readme",
  "bugs": {
    "url": "https://github.com/itashia/jalalits/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "jalali",
    "persian-calendar",
    "date",
    "typescript",
    "datetime",
    "timezone"
  ]
}
